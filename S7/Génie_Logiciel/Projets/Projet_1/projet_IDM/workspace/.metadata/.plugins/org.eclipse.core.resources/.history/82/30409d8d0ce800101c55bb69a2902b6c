package fr.n7.idm.layout.validation;

import java.util.List;
import java.util.Map;
import org.eclipse.emf.common.util.URI;
import org.eclipse.emf.ecore.resource.Resource;
import org.eclipse.emf.ecore.resource.ResourceSet;
import org.eclipse.emf.ecore.resource.impl.ResourceSetImpl;
import org.eclipse.emf.ecore.xmi.impl.XMIResourceFactoryImpl;
import fr.n7.idm.layout.LayoutPackage;

/**
 * Programme principal pour valider des fichiers .layout
 * 
 * Usage: java ValidateLayout fichier1.layout fichier2.layout ...
 * 
 * @author Oussama
 * @version 1.0
 */
public class ValidateLayout {
    
    /**
     * Afficher une liste d'erreur avec un préfixe.
     */
    private static void afficherErreurs(String prefix, List<ValidationResult.ValidationError> errors) {
        System.out.print(prefix + ": ");
        if (errors.isEmpty()) {
            System.out.println("OK");
        } else {
            System.out.println(errors.size() + " erreur(s) trouvée(s)");
            for (ValidationResult.ValidationError error : errors) {
                System.out.println("  => " + error.toString());
            }
        }
    }
    
    /**
     * Affiche les erreurs pour les divers éléments du méta-modèle.
     */
    private static void afficherResultat(ValidationResult resultat) {
        afficherErreurs("- Layout", resultat.getRecordedErrorsFor(LayoutPackage.LAYOUT));
        afficherErreurs("- Board", resultat.getRecordedErrorsFor(LayoutPackage.BOARD));
        afficherErreurs("- Couche", resultat.getRecordedErrorsFor(LayoutPackage.COUCHE));
        afficherErreurs("- CoucheExterne", resultat.getRecordedErrorsFor(LayoutPackage.COUCHE_EXTERNE));
        afficherErreurs("- CoucheInterne", resultat.getRecordedErrorsFor(LayoutPackage.COUCHE_INTERNE));
        afficherErreurs("- ComposantPlace", resultat.getRecordedErrorsFor(LayoutPackage.COMPOSANT_PLACE));
        afficherErreurs("- Piste", resultat.getRecordedErrorsFor(LayoutPackage.PISTE));
        afficherErreurs("- Point", resultat.getRecordedErrorsFor(LayoutPackage.POINT));
    }
    
    /**
     * Fonction principale.
     */
    public static void main(String... args) {
        // Charger le méta-modèle
        @SuppressWarnings("unused")
        LayoutPackage packageInstance = LayoutPackage.eINSTANCE;
        
        // Enregistrer les extensions de fichiers
        Resource.Factory.Registry reg = Resource.Factory.Registry.INSTANCE;
        Map<String, Object> m = reg.getExtensionToFactoryMap();
        m.put("xmi", new XMIResourceFactoryImpl());
        m.put("layout", new XMIResourceFactoryImpl());
        
        ResourceSet resSet = new ResourceSetImpl();
        LayoutValidator validator = new LayoutValidator();
        
        for (String model : args) {
            URI modelURI = URI.createURI(model);
            Resource resource = resSet.getResource(modelURI, true);
            ValidationResult resultat = validator.validate(resource);
            
            System.out.println("\n=== Validation de " + model + " ===");
            afficherResultat(resultat);
        }
        
        System.out.println("\nValidation terminée.");
    }
}
